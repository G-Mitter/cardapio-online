# Copie este arquivo para ".env" e preencha os valores.
# O ".env" nunca vai para o GitHub (está no .gitignore) porque guarda segredos.

# Endereço do banco Postgres.
# Local (docker compose up -d db): postgres://postgres:postgres@127.0.0.1:5432/cardapio
# Produção: a connection string do Neon.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cardapio

# Chave usada para assinar os logins do /admin. Use um texto longo e aleatório.
# Gere um com:  openssl rand -hex 32
PAYLOAD_SECRET=troque-por-um-texto-longo-e-aleatorio

# Token do Vercel Blob (onde as imagens ficam em produção).
# A Vercel cria esta variável sozinha quando você liga o Blob no projeto.
# No seu computador, deixe vazio: as imagens vão para a pasta media/.
BLOB_READ_WRITE_TOKEN=

# Login do administrador geral criado pelo `pnpm seed` (só na primeira vez).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Seu WhatsApp para os botões de contato da página inicial (só dígitos, com 55 e DDD).
# Vazio: os botões não aparecem. Mudou na Vercel? Faça um novo deploy.
CONTATO_WHATSAPP=

# Chave do Google Maps Platform (Routes API) para ordenar as paradas da rota de entrega.
# Vazio: a rota sai na ordem dos pedidos, sem otimizar. Mudou na Vercel? Faça um novo deploy.
GOOGLE_MAPS_KEY=
